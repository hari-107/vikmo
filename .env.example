# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealerdesk
SUPPLIER_API_URL=http://127.0.0.1:8099
SUPPLIER_API_KEY=dev-supplier-key
DJANGO_SECRET_KEY=change-me

# Gemini Provider Configuration (Primary LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_PREFERENCES=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.1-flash-lite

# Groq Provider Configuration (Secondary Fallback LLM)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENABLED=true

# Alternative LLM Provider Keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
